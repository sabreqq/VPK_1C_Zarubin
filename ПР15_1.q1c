<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="АКВ">
		<text>ВЫБРАТЬ
	ЗаказЗапасы.Ссылка КАК Заказ,
	ЗаказЗапасы.Номенклатура КАК Номенклатура,
	ЗаказЗапасы.Ссылка.ВалютаДокумента КАК Валюта,
	ЗаказЗапасы.Цена КАК ЦенаВВалютеДокумента
ИЗ
	Документ.ЗаказПокупателя.Запасы КАК ЗаказЗапасы
ГДЕ
	ЗаказЗапасы.Ссылка.Проведен = ИСТИНА
	И ЗаказЗапасы.Ссылка.ВидЦен = &amp;ВидЦен
	И ЗаказЗапасы.Ссылка.Дата &lt;= &amp;Период

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗаказРаботы.Ссылка,
	ЗаказРаботы.Номенклатура,
	ЗаказРаботы.Ссылка.ВалютаДокумента,
	ЗаказРаботы.Цена
ИЗ
	Документ.ЗаказПокупателя.Работы КАК ЗаказРаботы
ГДЕ
	ЗаказРаботы.Ссылка.Проведен = ИСТИНА
	И ЗаказРаботы.Ссылка.ВидЦен = &amp;ВидЦен
	И ЗаказРаботы.Ссылка.Дата &lt;= &amp;Период
	
</text>
		<textSQL>

		</textSQL>
		<planSQL>

		</planSQL>
		<typeSQL>

		</typeSQL>
		<parameters>
			<parameter name="ВидЦен" type="CatalogRef.ВидыЦен" value="7481362d-b5b8-11e4-8355-74d02b7dfd8c"/>
			<parameter name="Период" type="Дата" value="2026-04-21T00:00:00"/>
		</parameters>
	</query>
</querylist>